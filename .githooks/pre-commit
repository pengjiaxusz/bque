#!/bin/sh
# gate hook: the pre-commit stage.
#
# Two checks run before a commit lands:
#   1. the staged Rust files are formatted with rustfmt;
#   2. the code language guard checks the staged files against `.gate.toml`.
#
# The gate lives in `pengj-templates-cli` and nowhere else: this hook only finds the binary and hands the work to `pengj-templates-cli gate hook pre-commit`. One binary covers the template engine, the MCP installer and the commit gate. No CLI means no rule set, so the commit is blocked with install instructions instead of being let through by a check that cannot run.

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# Locate the CLI: PATH first, then the installation directory. The second step matters for terminals opened before the installer refreshed PATH — without it a working install would look like a missing one.
if command -v pengj-templates-cli >/dev/null 2>&1; then
    exec pengj-templates-cli gate hook pre-commit
fi

for candidate in \
    "${PENGJ_INSTALL_DIR:+$PENGJ_INSTALL_DIR/bin/pengj-templates-cli.exe}" \
    "${PENGJ_INSTALL_DIR:+$PENGJ_INSTALL_DIR/bin/pengj-templates-cli}" \
    "${LOCALAPPDATA:+$LOCALAPPDATA/pengj-templates/bin/pengj-templates-cli.exe}" \
    "${XDG_DATA_HOME:+$XDG_DATA_HOME/pengj-templates/bin/pengj-templates-cli}" \
    "${HOME:+$HOME/.local/share/pengj-templates/bin/pengj-templates-cli}"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" gate hook pre-commit
    fi
done

echo "[gate] commit blocked: pengj-templates-cli was not found on PATH or in the installation directory." >&2
echo "[gate] rustfmt and the code language guard live inside the CLI, so there is no local check to fall back to. Install it once and the gate comes with it:" >&2
echo "[gate]   irm https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.ps1 | iex" >&2
echo "[gate]   curl -fsSL https://github.com/pengjiaxusz/pengj-templates/releases/latest/download/install.sh | sh" >&2
exit 1